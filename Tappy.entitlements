<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Deliberately empty. Tappy reads the built-in accelerometer as a raw
         IOHIDDevice, which needs no entitlement of its own but is not
         compatible with the App Sandbox — so this ships Developer ID signed
         and notarized with the hardened runtime, outside the Mac App Store.
         Adding com.apple.security.app-sandbox here would break detection. -->
</dict>
</plist>
