<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notarization requires the hardened runtime, and under it the mic is
         blocked unless the signature carries this entitlement. Without it a
         notarized Tappy is deaf no matter what the user allows in Settings. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
